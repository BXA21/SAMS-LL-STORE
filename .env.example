# ---------------------------------------------------------------------------
# Supabase
# The URL and publishable (anon) key are public by design: row level security
# limits them to the active catalog. The service role key bypasses RLS and must
# only ever exist on the server (never prefix it NEXT_PUBLIC_).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Paymob Oman (Unified Intention API + Unified Checkout)
# Dashboard: Settings -> API Keys, and Developers -> Payment Integrations.
# Use the TEST keys until the live account is approved.
# ---------------------------------------------------------------------------
PAYMOB_BASE_URL=https://oman.paymob.com
PAYMOB_PUBLIC_KEY=omn_pk_test_xxx
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
# Card integration id(s); comma-separate to offer several payment methods.
PAYMOB_INTEGRATION_ID=
# Paymob API key (Settings -> API Keys -> "API key"): used ONLY by the recovery
# worker to verify refunds/voids via Transaction Inquiry. Without it refund
# reports are queued but not applied.
PAYMOB_API_KEY=
# Verify on staging: exact Oman Transaction Inquiry path and auth endpoint.
PAYMOB_INQUIRY_PATH=/api/acceptance/transactions/{id}
PAYMOB_AUTH_PATH=/api/auth/tokens
# Public base URL Paymob posts the transaction webhook to. Leave empty in
# production (the site URL is used). For local testing set it to a tunnel URL.
PAYMOB_CALLBACK_BASE_URL=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The ONE request header the host sets with the real client IP; used for rate
# limiting. Netlify: x-nf-client-connection-ip (also inferred when NETLIFY=true).
# Leave empty locally. Never point this at X-Forwarded-For.
CLIENT_IP_HEADER=

# ---------------------------------------------------------------------------
# Recovery worker (POST /api/internal/recovery, Netlify scheduled function)
# ---------------------------------------------------------------------------
# Random secret, at least 32 characters. Empty = endpoint disabled.
RECOVERY_WORKER_SECRET=

# ---------------------------------------------------------------------------
# Notifications (outbox). Default "disabled": nothing is ever sent.
# ---------------------------------------------------------------------------
NOTIFICATION_PROVIDER=disabled
# Local tests only (must be localhost):
MOCK_EMAIL_URL=
# Staff inbox for "new paid order" emails (not stored in the database).
ORDER_NOTIFICATION_EMAIL=
# Shown to customers in confirmation emails.
SUPPORT_EMAIL=

# Staff accounts are Supabase Auth users with a row in public.staff_profiles
# (role owner or sales). There are no passwords in environment variables.
